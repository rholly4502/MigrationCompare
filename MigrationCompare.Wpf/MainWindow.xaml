<Window x:Class="MigrationCompare.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MigrationCompare — Komparasi &amp; Kualitas Data"
        Height="900" Width="1220" MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F2F4F8"
        FontFamily="Segoe UI" FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EFF4FF"/>
        <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
        <SolidColorBrush x:Key="Slate600" Color="#475569"/>
        <SolidColorBrush x:Key="Slate500" Color="#64748B"/>
        <SolidColorBrush x:Key="Slate300" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Slate200" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Surface" Color="White"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerDark" Color="#B91C1C"/>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="FontSize" Value="16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F1707A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="FrozenColumnCount" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar (custom chrome) ===== -->
        <Border Grid.Row="0" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="⧉" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MigrationCompare" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Komparasi &amp; Kualitas Data" Foreground="#94A3B8" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            ToolTip="Minimalkan" Click="Minimize_Click"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            ToolTip="Perbesar/Perkecil" Click="Maximize_Click"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Tutup" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Scrollable form area -->
            <ScrollViewer Grid.Row="0" MaxHeight="500" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,0">
                <StackPanel>
                    <!-- Sumber A & B -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sumber A -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                               Text="Sumber A (Data Asal / Lama)" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TestConnA" Content="Test Koneksi" Padding="10,4" FontSize="11"
                                                Margin="0,0,6,0" Click="TestConnA_Click" Style="{StaticResource AppButton}"
                                                ToolTip="Uji koneksi &amp; validasi kolom query"/>
                                        <Button Content="Isi Contoh" Padding="10,4" FontSize="11"
                                                Click="FillSampleA_Click" Style="{StaticResource AppButton}"
                                                ToolTip="Isi contoh konfigurasi untuk Sumber A"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Jenis Sumber Data:" Margin="0,4,0,2"/>
                                <ComboBox x:Name="KindA" SelectedIndex="0">
                                    <ComboBoxItem Content="SQL Server"/>
                                    <ComboBoxItem Content="CSV File"/>
                                </ComboBox>

                                <StackPanel x:Name="SqlAuthSectionA">
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server / Host:"/>
                                            <TextBox x:Name="ServerA" ToolTip="Contoh: localhost, 10.0.0.1,1433"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Database:"/>
                                            <TextBox x:Name="DatabaseA" ToolTip="Nama database, mis. LegacyDb"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Autentikasi:"/>
                                            <ComboBox x:Name="AuthModeA" SelectedIndex="0" SelectionChanged="AuthModeA_Changed">
                                                <ComboBoxItem Content="SQL Login (User &amp; Pass)"/>
                                                <ComboBoxItem Content="Windows Authentication"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Username:"/>
                                            <TextBox x:Name="UserA" ToolTip="Username SQL Server"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password:"/>
                                            <PasswordBox x:Name="PassA" ToolTip="Password SQL Server"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="ConnLabelA" Style="{StaticResource FieldLabel}"
                                           Text="Connection String Tambahan / Override (opsional):"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ConnectionA" Grid.Column="0"
                                             ToolTip="Opsional untuk SQL; wajib untuk CSV."/>
                                    <Button x:Name="BrowseA" Grid.Column="1" Content="Pilih File..." Margin="6,0,0,0"
                                            Padding="10,4" Click="BrowseA_Click" Visibility="Collapsed" Style="{StaticResource AppButton}"/>
                                </Grid>
                                <TextBlock x:Name="ConnHintA" Style="{StaticResource FieldHint}"
                                           Text="Opsional jika Server, Database, Username &amp; Password di atas sudah diisi."/>

                                <StackPanel x:Name="QuerySectionA">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Query SELECT (SQL):"/>
                                    <TextBox x:Name="QueryA" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Height="52" FontFamily="Consolas" FontSize="12"
                                             ToolTip="Tambahkan ORDER BY kolom kunci + aktifkan Mode Streaming untuk data besar."/>
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Contoh: SELECT BillingNo, Amount, Status FROM dbo.Transactions ORDER BY BillingNo"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Kolom Kunci / Primary Key (wajib, pisah koma):"/>
                                <TextBox x:Name="KeysA" ToolTip="Nama kolom kunci join yang unik per baris"/>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Contoh: BillingNo  atau  CustomerId, InvoiceNo"/>
                            </StackPanel>
                        </Border>

                        <!-- Sumber B -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                               Text="Sumber B (Data Tujuan / Baru)" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TestConnB" Content="Test Koneksi" Padding="10,4" FontSize="11"
                                                Margin="0,0,6,0" Click="TestConnB_Click" Style="{StaticResource AppButton}"
                                                ToolTip="Uji koneksi &amp; validasi kolom query"/>
                                        <Button Content="Isi Contoh" Padding="10,4" FontSize="11"
                                                Click="FillSampleB_Click" Style="{StaticResource AppButton}"
                                                ToolTip="Isi contoh konfigurasi untuk Sumber B"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Jenis Sumber Data:" Margin="0,4,0,2"/>
                                <ComboBox x:Name="KindB" SelectedIndex="0">
                                    <ComboBoxItem Content="SQL Server"/>
                                    <ComboBoxItem Content="CSV File"/>
                                </ComboBox>

                                <StackPanel x:Name="SqlAuthSectionB">
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server / Host:"/>
                                            <TextBox x:Name="ServerB" ToolTip="Contoh: localhost, 10.0.0.2,1433"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Database:"/>
                                            <TextBox x:Name="DatabaseB" ToolTip="Nama database, mis. NewDb"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Autentikasi:"/>
                                            <ComboBox x:Name="AuthModeB" SelectedIndex="0" SelectionChanged="AuthModeB_Changed">
                                                <ComboBoxItem Content="SQL Login (User &amp; Pass)"/>
                                                <ComboBoxItem Content="Windows Authentication"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Username:"/>
                                            <TextBox x:Name="UserB" ToolTip="Username SQL Server"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password:"/>
                                            <PasswordBox x:Name="PassB" ToolTip="Password SQL Server"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="ConnLabelB" Style="{StaticResource FieldLabel}"
                                           Text="Connection String Tambahan / Override (opsional):"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ConnectionB" Grid.Column="0"
                                             ToolTip="Opsional untuk SQL; wajib untuk CSV."/>
                                    <Button x:Name="BrowseB" Grid.Column="1" Content="Pilih File..." Margin="6,0,0,0"
                                            Padding="10,4" Click="BrowseB_Click" Visibility="Collapsed" Style="{StaticResource AppButton}"/>
                                </Grid>
                                <TextBlock x:Name="ConnHintB" Style="{StaticResource FieldHint}"
                                           Text="Opsional jika Server, Database, Username &amp; Password di atas sudah diisi."/>

                                <StackPanel x:Name="QuerySectionB">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Query SELECT (SQL):"/>
                                    <TextBox x:Name="QueryB" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Height="52" FontFamily="Consolas" FontSize="12"
                                             ToolTip="Tambahkan ORDER BY kolom kunci + aktifkan Mode Streaming untuk data besar."/>
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Contoh: SELECT BillingNo, Amount, Status FROM dbo.Transactions_Migrated ORDER BY BillingNo"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Kolom Kunci / Primary Key (wajib, pisah koma):"/>
                                <TextBox x:Name="KeysB" ToolTip="Kosongkan jika sama dengan Sumber A"/>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Contoh: BillingNo  (kosongkan jika sama dengan Sumber A)"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Opsi & tombol aksi -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="14,10">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                                    <TextBlock Text="Kolom dibandingkan (opsional):" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBox x:Name="CompareColsInput" Width="220"
                                             ToolTip="Pisah koma, mis. Amount, Status. Kosongkan = semua kolom non-key."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToleranceBox" Content="Toleransi numerik:"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Checked="ToleranceBox_Changed" Unchecked="ToleranceBox_Changed"/>
                                    <TextBox x:Name="ToleranceInput" Width="68" VerticalAlignment="Center"
                                             Text="0.01" IsEnabled="False"
                                             ToolTip="Selisih maksimal yang dianggap sama (mis. 0.01)"/>
                                </StackPanel>
                                <CheckBox x:Name="StreamingModeBox" VerticalAlignment="Center" Margin="0,0,0,4"
                                          Content="Mode Streaming Hemat RAM (data terurut ORDER BY key)"
                                          ToolTip="RAM konstan O(1). Wajib query A &amp; B ORDER BY kolom kunci."/>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="CompareBtn" Content="Bandingkan (A vs B)"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="CompareBtn_Click"/>
                                <Button x:Name="QualityABtn" Content="Cek Kualitas A" Margin="0,0,8,0"
                                        Click="QualityABtn_Click" Style="{StaticResource AppButton}"/>
                                <Button x:Name="QualityBBtn" Content="Cek Kualitas B" Margin="0,0,8,0"
                                        Click="QualityBBtn_Click" Style="{StaticResource AppButton}"/>
                                <Button x:Name="CancelBtn" Content="Batal ✕" Margin="0,0,8,0"
                                        Style="{StaticResource DangerButton}" IsEnabled="False" Click="CancelBtn_Click"/>
                                <Button x:Name="SaveBtn" Content="Simpan Laporan (MD / CSV)"
                                        Click="SaveBtn_Click" IsEnabled="False" Style="{StaticResource AppButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metrik -->
                    <UniformGrid x:Name="MetricsPanel" Columns="6" Margin="0,12,0,0">
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Total Baris A" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MetricTotalA" Text="-" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Total Baris B" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MetricTotalB" Text="-" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Cocok (Matched)" FontSize="11" Foreground="#15803D"/>
                                <TextBlock x:Name="MetricMatched" Text="-" FontSize="17" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Beda Nilai" FontSize="11" Foreground="#B45309"/>
                                <TextBlock x:Name="MetricDiff" Text="-" FontSize="17" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Hanya di A" FontSize="11" Foreground="#B91C1C"/>
                                <TextBlock x:Name="MetricOnlyA" Text="-" FontSize="17" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Hanya di B" FontSize="11" Foreground="#B91C1C"/>
                                <TextBlock x:Name="MetricOnlyB" Text="-" FontSize="17" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter -->
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Filter Status:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="StatusFilter" Width="170" SelectedIndex="0" SelectionChanged="FilterChanged" IsEnabled="False">
                                <ComboBoxItem Content="Semua Perbedaan"/>
                                <ComboBoxItem Content="Cocok (Beda Nilai)"/>
                                <ComboBoxItem Content="Hanya di A"/>
                                <ComboBoxItem Content="Hanya di B"/>
                            </ComboBox>
                            <TextBlock Text="Cari Key:" VerticalAlignment="Center" Margin="14,0,6,0"
                                       FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBox x:Name="SearchKeyBox" Width="200" TextChanged="FilterChanged" IsEnabled="False"
                                     ToolTip="Ketik sebagian/seluruh key untuk memfilter"/>
                        </StackPanel>
                        <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#475569" Text="Belum ada hasil. Klik 'Bandingkan'."
                                   TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Results area (selalu terlihat, scroll sendiri) -->
            <Grid Grid.Row="1" Margin="14,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="ResultGrid" Grid.Row="0" Margin="0,10,0,0"
                          AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"/>
                <TextBlock x:Name="GridCaption" Grid.Row="1" Margin="0,6,0,0"
                           Text="Hasil perbedaan atau laporan kualitas akan muncul di tabel di atas."
                           Foreground="#64748B" FontSize="12"/>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <StatusBar Grid.Row="2" Background="#0F172A" Padding="14,6">
            <StatusBarItem>
                <DockPanel LastChildFill="True">
                    <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="12"
                                 IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Siap." Foreground="#CBD5E1"/>
                </DockPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
